# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your deployment:
#   cp .env.example .env
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db

# Host port mappings
HOST_POSTGRES_PORT=5433
HOST_APP_PORT=8000
HOST_REDIS_PORT=6379

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Cache-Aside Settings
CACHE_TTL_SECONDS=60
